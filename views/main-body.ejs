
<div class="img-con">
  <% animeList.forEach(anime => { %>
    <div class="card img-card holographic-container" style="width: 18rem;">
      <div class="card-body holographic-card">
        <img
          src="<%= anime.image %>"
          class="card-img"
          alt="<%= anime.title %>"
        >

        <h2><%= anime.title %></h2>
        <p><%= anime.description %></p>
        <p>Status: <%= anime.status %></p>
        <p>Rating: <%= anime.rating %></p>
      </div>
    </div>
  <% }) %>
</div>
